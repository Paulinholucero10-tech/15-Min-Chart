# Copy this file to .env and fill in at least one notification channel.

# --- When to alert -------------------------------------------------------
# Your local timezone (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=America/New_York
WINDOW_START=08:00
# End is exclusive: alerts at 8:00, 8:15 ... 11:45 (16 alerts; the last covers 11:45-12:00)
WINDOW_END=12:00
INTERVAL_MINUTES=15
# Set to true to skip Saturdays and Sundays
WEEKDAYS_ONLY=false

# --- Signal ----------------------------------------------------------------
# Below this confidence (%) the bot says SKIP. Higher = fewer but stronger calls.
MIN_CONFIDENCE=60
PRODUCT=BTC-USD

# --- Notifications (configure one or more) --------------------------------
# Option A: ntfy - easiest. Install the "ntfy" app, subscribe to a hard-to-guess topic name.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Option B: Telegram. Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option C: Discord channel webhook URL
DISCORD_WEBHOOK_URL=

# --- AI explanations (optional) --------------------------------------------
# Adds a plain-English "Why" to each alert, written by Claude. The UP/DOWN/SKIP
# call itself always comes from the indicators. Get a key at console.anthropic.com.
# Costs roughly a cent or two per day (16 short requests).
ANTHROPIC_API_KEY=
# AI_EXPLANATIONS=false   # turn off without removing the key

# --- Dashboard ---------------------------------------------------------------
# Live chart + today's calls at http://localhost:8080 while the bot runs.
DASHBOARD=true
DASHBOARD_PORT=8080
# 127.0.0.1 = only this computer can open it. Use 0.0.0.0 to open it from your
# phone on the same Wi-Fi (http://<computer-ip>:8080). Don't expose it to the internet.
DASHBOARD_HOST=127.0.0.1
